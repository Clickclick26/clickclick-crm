VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — real outbound calling IS now wired into the dialer
# (see src/lib/telnyx/client.ts). Leave blank and the dialer keeps using the
# simulated call, exactly as before. Set it and startCall() places a real
# Telnyx call, presenting the selected from-number as caller ID.
# Use a short-lived JWT login token, never a long-lived API key — anything
# in a VITE_ var is shipped to the browser in plain text.
VITE_TELNYX_LOGIN_TOKEN=
